# คัดลอกเป็น /var/www/reserva/.env บนเซิร์ฟเวอร์ แล้วแก้ค่าตามจริง

# host ภายใต้ subpath /reserva
NEXT_PUBLIC_BASE_PATH=/reserva

# ฐานข้อมูล SQLite
DATABASE_PATH=/var/www/reserva/data/reserva.db

# secret สำหรับ cookie (สุ่มเอง อย่างน้อย 32 ตัว)
SESSION_SECRET=__เปลี่ยนเป็น_random_string_ยาวๆ__

# token ป้องกัน /api/cron (ถ้ายังใช้ HTTP cron แทน systemd timer)
CRON_SECRET=__เปลี่ยนเป็น_random_string_ยาวๆ__

# URL หลักของระบบ
PUBLIC_BASE_URL=https://ikigaimedihealth.com/reserva

# จำนวนวันเก็บข้อมูล booking ก่อนลบทิ้ง
RETENTION_DAYS=60
