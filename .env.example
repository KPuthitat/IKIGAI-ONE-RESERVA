# Path ของไฟล์ฐานข้อมูล SQLite ของ RESERVA (booking + sessions + time_entries)
DATABASE_PATH=./data/reserva.db

# Path ของฐานข้อมูล Payroll (read-only — ใช้ดึง users สำหรับ unified login)
PAYROLL_DB_PATH=/var/www/ikigai-payroll/webapp/db/payroll.db

# Secret สำหรับเซ็น session cookie (สุ่ม 32+ ตัวอักษร)
SESSION_SECRET=change-me-to-a-long-random-string-please

# Base URL ของระบบ (ใช้ในลิงก์จองที่ส่งให้ลูกค้า)
PUBLIC_BASE_URL=http://localhost:3000

# LINE Messaging API ของแต่ละสาขา (ตั้งใน admin UI ก็ได้)
# LINE_CHANNEL_TOKEN_NAMA=
# LINE_CHANNEL_SECRET_NAMA=
# LINE_CHANNEL_TOKEN_HYPO=
# LINE_CHANNEL_SECRET_HYPO=

# LIFF ID สำหรับ Staff Invite (สร้างใต้ LINE Login channel ใน provider เดียวกับ
# IKIGAI OS PLATFORM Messaging API). ปลายทางตั้งเป็น /persona/invite
# พนักงานเปิดลิงก์เชิญใน LINE → LIFF init → จับ userId อัตโนมัติ → bind กับ
# user row โดยไม่ต้องให้ admin paste userId ทีหลัง
# NEXT_PUBLIC_* คือ env ที่ Next.js inject ลง client bundle ตอน build —
# ค่านี้เปิดเผยใน HTML อยู่แล้ว ไม่เป็นความลับ
NEXT_PUBLIC_LIFF_ID_INVITE=

# LIFF ID สำหรับ Staff Portal — one-tap login จาก rich menu LINE OA.
# สร้างใต้ LINE Login channel เดียวกับ INVITE (เพื่อให้ userId match กัน).
# Endpoint URL ตั้งเป็น /persona/portal — พนักงานกด rich menu → LIFF init
# → verify accessToken กับ LINE Profile API → ระบบสร้าง session ทันที
# ไม่ต้องกรอก username/password
NEXT_PUBLIC_LIFF_ID_PORTAL=

# Token สำหรับเรียก /api/cron (ใส่ใน header x-cron-token)
CRON_SECRET=change-me-too-please

# จำนวนวันเก็บข้อมูล booking (default 60 วัน)
RETENTION_DAYS=60

# ACCOUNTA bill-OCR — Anthropic API key สำหรับอ่านรูปบิล/ใบเสร็จ (ภาพ → กรอกฟอร์ม
# อัตโนมัติ). จำเป็นเฉพาะเมื่อเปิดสวิตช์ OCR ใน /admin/system-settings เท่านั้น —
# ถ้าไม่ตั้ง ระบบยังทำงานปกติ แค่ปุ่มถ่ายรูปบิลจะแจ้งว่ายังไม่ได้ตั้งค่า
ANTHROPIC_API_KEY=

# ─── DELIVERA (self-delivery module) ───────────────────────────────────────
# จำเป็นเฉพาะสาขาที่เปิด delivera_enabled เท่านั้น — โมดูลตรวจ env แบบ lazy
# (ไม่ตั้ง = โมดูลไม่ทำงาน แต่แอปส่วนอื่นยังรันปกติ)
# LINE OA ลูกค้า (channel แยกจาก OA พนักงาน) + LIFF สั่งอาหาร
LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN=
LINE_CUSTOMER_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_CUSTOMER_LIFF_ID=
# LINE OA ไรเดอร์ (channel แยกเด็ดขาดจากลูกค้า) + LIFF งานส่ง
LINE_RIDER_CHANNEL_ACCESS_TOKEN=
LINE_RIDER_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_RIDER_LIFF_ID=
# SlipOK — ตรวจสลิปโอนกับธนาคาร (สมัคร key ที่ https://slipok.com)
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# Google Maps Distance Matrix (ไม่บังคับ — ถ้าไม่ตั้ง ใช้ Haversine)
GOOGLE_MAPS_API_KEY=
# Secret สำหรับเซ็น token ภายใน DELIVERA (สุ่ม 32+ ตัวอักษร)
DELIVERA_HMAC_SECRET=
