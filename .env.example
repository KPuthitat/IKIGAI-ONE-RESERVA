# Path ของไฟล์ฐานข้อมูล SQLite ของ RESERVA (booking + sessions + time_entries)
DATABASE_PATH=./data/reserva.db

# Path ของฐานข้อมูล Payroll (read-only — ใช้ดึง users สำหรับ unified login)
PAYROLL_DB_PATH=/var/www/ikigai-payroll/webapp/db/payroll.db

# Secret สำหรับเซ็น session cookie (สุ่ม 32+ ตัวอักษร)
SESSION_SECRET=change-me-to-a-long-random-string-please

# Base URL ของระบบ (ใช้ในลิงก์จองที่ส่งให้ลูกค้า)
PUBLIC_BASE_URL=http://localhost:3000

# LINE Messaging API ของแต่ละสาขา (ตั้งใน admin UI ก็ได้)
# LINE_CHANNEL_TOKEN_NAMA=
# LINE_CHANNEL_SECRET_NAMA=
# LINE_CHANNEL_TOKEN_HYPO=
# LINE_CHANNEL_SECRET_HYPO=

# Token สำหรับเรียก /api/cron (ใส่ใน header x-cron-token)
CRON_SECRET=change-me-too-please

# จำนวนวันเก็บข้อมูล booking (default 60 วัน)
RETENTION_DAYS=60
