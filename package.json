{
  "name": "ikigai-os-reserva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node --import tsx scripts/check-i18n.ts && node scripts/scan-build-risks.mjs && npx tsc --noEmit -p tsconfig.json",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:i18n": "node --import tsx scripts/check-i18n.ts",
    "check:risks": "node scripts/scan-build-risks.mjs",
    "check:types": "npx tsc --noEmit -p tsconfig.json",
    "db:init": "node --import tsx scripts/init-db.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "cron:run": "node --import tsx scripts/cron.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "html5-qrcode": "^2.3.8",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
